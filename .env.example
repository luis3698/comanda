# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

NODE_ENV=development
PORT=3000
TZ=America/Bogota

# --- Base de datos ---
DB_HOST=localhost
# Puerto que expone el contenedor MySQL hacia el anfitrion.
# Se usa 3307 para no chocar con un MySQL ya instalado en la maquina.
DB_PORT=3307
DB_NAME=sigr
DB_USER=sigr_app
DB_PASSWORD=sigr_app_dev
DB_ROOT_PASSWORD=root_sigr_dev

# Puerto del contenedor MySQL hacia el anfitrion (docker-compose).
DB_PORT_HOST=3307
# Puerto de la API hacia el anfitrion (docker-compose).
PORT_HOST=3000

# --- Seguridad ---
# Costo de bcrypt. El FSD 6.1 exige >= 12.
BCRYPT_COSTO=12
# Duracion de la sesion en horas. FSD 5.1: 12 h en dispositivos compartidos.
SESION_HORAS=12
# Minutos de inactividad tras los que se re-pide el PIN. FSD 5.1: 10 min.
SESION_INACTIVIDAD_MIN=10
# En produccion detras de HTTPS debe ser true (cookie Secure). FSD 6.1.
COOKIE_SEGURA=false

# --- Canal digital: aplicacion movil de clientes (ver MOVIL.md) ---
# Duracion de la sesion del cliente, en dias. Es mucho mas larga que la del
# personal (12 h) porque un movil es un dispositivo PERSONAL, no compartido:
# la regla de 12 h del FSD 5.1 protege comandero, KDS y POS, que pasan de mano
# en mano.
SESION_CLIENTE_DIAS=30

# Notificaciones push (Firebase Cloud Messaging).
# Se sacan del JSON de la cuenta de servicio: Consola de Firebase ->
# Configuracion del proyecto -> Cuentas de servicio -> Generar clave privada.
#
# SIN ESTAS VARIABLES EL SISTEMA FUNCIONA IGUAL: las notificaciones se guardan
# en la bandeja de la aplicacion y el cliente las ve al abrirla; solo no suena
# el aviso en el movil. No hace falta cuenta de Firebase para desarrollar ni
# para demostrar el sistema completo.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# La clave privada va en UNA sola linea, con los saltos escapados como \n.
FCM_PRIVATE_KEY=

# Mapa. Las teselas se sirven a traves de /api/v1/mapa/teselas para no relajar
# el CSP ni hablar con terceros desde el navegador (ver servicios/teselas.js).
MAPA_TESELAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Fuera de public/: estas imagenes NO se sirven como estaticos.
MAPA_CACHE_DIR=
# La politica de uso de OpenStreetMap exige un User-Agent identificable.
# Vale para las teselas Y para la geocodificacion de aqui abajo.
MAPA_USER_AGENT=SIGR/0.1 (sistema de gestion de restaurantes)

# Geocodificacion inversa: de un punto del mapa a una direccion escrita. Es lo
# que rellena sola la casilla "Direccion completa" cuando el cliente situa el
# pin en la aplicacion movil (ver servicios/geocodificacion.js).
#
# SIN ESTO EL SISTEMA FUNCIONA IGUAL: si el servicio no responde, la casilla
# simplemente no se autocompleta y el cliente la escribe a mano, como siempre.
#
# El valor de fabrica apunta al Nominatim publico de OpenStreetMap, que es
# gratuito pero admite UNA peticion por segundo en total. El servidor lo respeta
# (cola serializada y cache), y para un restaurante en marcha da de sobra. Para
# un despliegue con volumen, levante un Nominatim propio y apunte aqui.
MAPA_GEOCODIFICACION_URL=https://nominatim.openstreetmap.org/reverse
# Idioma de las direcciones devueltas. "es" para que diga Calle y no Street.
MAPA_IDIOMA=es
